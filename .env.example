# Server Configuration
APP_NAME="BuddyLens AI"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# Storage Settings
DATABASE_URL="sqlite:///./data/buddylens.db"
MAX_UPLOAD_SIZE_BYTES=15728640

# AI Provider Selection ("auto", "hosted", "ollama", "fallback")
# - "auto": Uses Hosted Gemma if configured, otherwise Ollama if reachable, else Fallback
# - "hosted": Prioritizes OpenAI-compatible Hosted Gemma (Groq, OpenRouter, vLLM)
# - "ollama": Prioritizes local Ollama instance (e.g. gemma2:2b)
# - "fallback": Forces Deterministic Study Engine (no external calls)
AI_PROVIDER="auto"

# 1. Hosted Open-Weight Gemma API settings (Recommended if Ollama is not installed)
# Works with any OpenAI-compatible provider offering Gemma models (e.g. Groq, OpenRouter, Together AI, vLLM)
# Examples:
#   For Groq:
#     HOSTED_API_BASE_URL="https://api.groq.com/openai/v1"
#     HOSTED_MODEL_NAME="gemma2-9b-it"
#     HOSTED_API_KEY="your_groq_api_key_here"
#   For OpenRouter:
#     HOSTED_API_BASE_URL="https://openrouter.ai/api/v1"
#     HOSTED_MODEL_NAME="google/gemma-2-9b-it"
#     HOSTED_API_KEY="your_openrouter_api_key_here"
HOSTED_API_BASE_URL=""
HOSTED_API_KEY=""
HOSTED_MODEL_NAME="gemma2-9b-it"

# 2. Local Open-Source Gemma (via Ollama)
# Privacy-first, runs 100% locally when Ollama is installed
OLLAMA_BASE_URL="http://localhost:11434"
GEMMA_MODEL_NAME="gemma2:2b"
